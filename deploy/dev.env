# Dev environment on Azure Container Apps. Read by scripts/azure/*.sh.
# Resource names and NON-secret settings only: secrets live in Key Vault
# ($KEY_VAULT_NAME) and setup.sh generates or prompts for any that are missing.
# Names marked "unique" must be globally unique in Azure; adjust if taken.
SUBSCRIPTION_ID=80c71a2e-f1ab-44d3-bc05-b24b25b3a237   # same subscription as the apex portal
LOCATION=canadacentral              # Burstable Postgres SKUs are available here (apex dev runs here too)
RESOURCE_GROUP=rg-perfreview-dev

# Registry: holds both images (api + web), tagged with the git SHA.
ACR_NAME=acrperfreviewdevemids      # unique, letters/numbers only
ACR_RESOURCE_GROUP=$RESOURCE_GROUP
API_IMAGE_REPO=performance-review-api
WEB_IMAGE_REPO=performance-review-web
BUILD_MODE=acr                      # 'docker' if ACR Tasks are blocked (TasksOperationsNotAllowed)

KEY_VAULT_NAME=kv-perfrev-dev-emids # unique, 3-24 chars
KV_PURGE_PROTECTION=false           # dev: allow purge/recreate; cannot be turned off once on
SECRETS_OFFICER_GROUP_ID=           # optional Entra group allowed to manage secrets
IDENTITY_NAME=id-perfreview-dev
LOG_WORKSPACE_NAME=log-perfreview-dev
LOG_RETENTION_DAYS=30

# dev: no VNet. Postgres keeps a public endpoint whose firewall admits only
# Azure-hosted clients; every connection needs the generated password over
# verified TLS. Use true for anything holding real review data.
PRIVATE_NETWORK=false
VNET_NAME=vnet-perfreview-dev       # used only when PRIVATE_NETWORK=true

POSTGRES_SERVER_NAME=pg-perfreview-dev-emids   # unique
POSTGRES_DB=performance_review
POSTGRES_VERSION=17
POSTGRES_TIER=Burstable
POSTGRES_SKU=Standard_B1ms          # ~50 connections: keep api replicas x workers x (pool+overflow) below it
POSTGRES_STORAGE_GB=32
POSTGRES_BACKUP_DAYS=7
POSTGRES_ZONE=                      # empty = first zone that offers POSTGRES_SKU; 'none' = no zone
POSTGRES_ADMIN_USER=pradmin

CONTAINERAPPS_ENV_NAME=cae-perfreview-dev
API_APP_NAME=ca-perfreview-api-dev  # internal ingress only; the web app proxies /api to it
WEB_APP_NAME=ca-perfreview-web-dev  # the only public endpoint
MIGRATE_JOB_NAME=caj-perfreview-migrate-dev
CUSTOM_HOSTNAME=                    # empty = the *.azurecontainerapps.io name

# Scale: dev scales to zero when idle (the first request after idle takes a few seconds).
API_CPU=0.5
API_MEMORY=1.0Gi
API_MIN_REPLICAS=0
API_MAX_REPLICAS=1
API_WORKERS=2                       # uvicorn workers per replica, each with its own pool
WEB_CPU=0.25
WEB_MEMORY=0.5Gi
WEB_MIN_REPLICAS=0
WEB_MAX_REPLICAS=1
HTTP_CONCURRENCY=50

# Application settings (backend/app/core/config.py).
# dev without PASSWORD_SIGN_IN keeps the email-only sign-in, which trusts
# whatever roster address is typed; with it, the form needs the shared
# provision password. Either way this is for test data: switch to prod (and
# fill in SSO below) before real reviews go in.
APP_ENVIRONMENT=dev
# qa.admin1-3 are off-roster test admins for the testing team (password sign-in only).
ADMIN_EMAILS='["pratheesh.sathyanaraynan@emids.com", "qa.admin1@emids.com", "qa.admin2@emids.com", "qa.admin3@emids.com"]'   # JSON list: HR admin console role

# Entra ID SSO for this portal's app registration. Leave the client id empty
# to keep SSO off. When set, setup prompts once for the client secret (stored
# in Key Vault as entra-client-secret), and the registration must list the
# redirect URI setup prints: https://<web host>/api/auth/sso/callback
ENTRA_TENANT_ID=6077507f-bcd4-4ca1-bebd-e4ac1d05ffa4   # the emids tenant
ENTRA_CLIENT_ID=6c151a38-7b11-4fb1-b22f-52dee78d9cab   # "Performance Review Project" app registration

# Shared sign-in password for the email form (Key Vault provision-password,
# generated by setup unless KV_SEED_PROVISION_PASSWORD is given). Every roster
# employee and ADMIN_EMAILS address signs in with it; the email-only sign-in
# is off while this is true. Read it with the command setup prints.
PASSWORD_SIGN_IN=true

# Branch allowed to deploy here (empty = any branch, handy for feature testing)
DEPLOY_BRANCH=
