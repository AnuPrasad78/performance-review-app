# Copy to backend/.env (gitignored) and fill in the values.
# Every variable is PR_-prefixed; the backend reads nothing but this file and
# the process environment (backend/app/core/config.py).

# --- Database (required) -------------------------------------------------
# The engine is async-only: the scheme must start with postgresql+asyncpg://
PR_DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<database>

# --- Environment ---------------------------------------------------------
# dev (default) keeps the email-only stub login; prod forbids it and demands SSO.
# PR_ENVIRONMENT=dev

# --- Admin console (dev) -------------------------------------------------
# JSON list of emails holding the admin console role while roles live in
# settings (migration A5 will move them to user_accounts.auth_role).
# PR_STUB_ADMIN_EMAILS='["boss@emids.com"]'

# --- Extra CORS origins (prod) -------------------------------------------
# Vite's localhost:5173 is always allowed; add deployed origins here.
# PR_CORS_ORIGINS='["https://<your-frontend-host>"]'

# --- Entra ID (Microsoft) SSO -------------------------------------------
# From the app registration's Overview: Principal > Properties blade.
PR_ENTRA_TENANT_ID=<Directory (tenant) ID>
PR_ENTRA_CLIENT_ID=<Application (client) ID>
# The client secret VALUE shown once when the credential was created — the
# Secret ID alone is not usable; create a new secret if the value was lost.
PR_ENTRA_CLIENT_SECRET=<client secret value>
# Must be registered under Authentication > Web > Redirect URIs in Entra.
# Near it: <backend>/api/auth/sso/callback. The backend serves the redirect,
# so the URI points at wherever /api is reachable (the Vite proxy in dev).
PR_SSO_REDIRECT_URI=http://localhost:5173/api/auth/sso/callback
# Signs this app's own session cookie, independent of Entra. Generate a long
# random value: python -c "import secrets; print(secrets.token_urlsafe(32))"
PR_SESSION_SECRET=<random string>
# Where the SPA lives; the SSO callback bounces the browser back here.
PR_APP_URL=http://localhost:5173

# --- Cookie name (rarely changed) ----------------------------------------
# PR_SESSION_COOKIE_NAME=pr_session

# --- Connection pool (per worker process) --------------------------------
# Total connections = replicas x workers x (size + overflow); keep it under the
# server's max_connections (docs/deployment.md has the sizing rule).
# Azure Database for PostgreSQL enforces TLS: append ?ssl=require to the URL.
# PR_DB_POOL_SIZE=5
# PR_DB_MAX_OVERFLOW=5
# PR_DB_POOL_TIMEOUT=10
# PR_DB_POOL_RECYCLE=1800
